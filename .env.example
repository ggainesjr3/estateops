# Database (PostgreSQL)
DATABASE_HOST=localhost
# Host port mapped by docker-compose (5433 avoids conflict with a local Postgres on 5432)
DATABASE_PORT=5433
DATABASE_USER=estateops
DATABASE_PASSWORD=estateops
DATABASE_NAME=estateops

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# API (NestJS)
HOST=0.0.0.0
PORT=3001
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
